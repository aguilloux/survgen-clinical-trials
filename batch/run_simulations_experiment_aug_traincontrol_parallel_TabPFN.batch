#!/bin/bash
#SBATCH --job-name=sim_TabPFN_exp_aug_traincontrol_parallel
#SBATCH --output=logs/sim_TabPFN_exp_aug_traincontrol_%A_%a.out
#SBATCH --error=logs/sim_TabPFN_exp_aug_traincontrol_%A_%a.err
#SBATCH --array=0-29  # 2D: idx = MC_id * 5 + generator_id  (6 MC blocks x 5 TabPFN models)
#SBATCH --cpus-per-task=8
#SBATCH --time=2-00:00:00
#SBATCH --mem=16G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:rtx8000:1
#SBATCH --exclude=gpu012,gpu013,gpu015,gpu016,gpu017,gpu009,gpu004,gpu001,gpu018,gpu014,gpu011

echo "### Starting GPU job: $SLURM_JOB_NAME ###"
cd ${SLURM_SUBMIT_DIR}

module purge

# Load your Python environment
source /home/$USER/.bashrc
source activate hivae

# TabPFN + SurvivalPFN weights are pre-downloaded on the login node; keep the
# offline compute node from trying to reach Hugging Face.
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

# Arguments
task_ID=${SLURM_ARRAY_TASK_ID}
cd ../script
# task_ID is decoded into (MC block, generator) inside the script
python3 simulation_experiment_aug_traincontrol_parallel_TabPFN.py $task_ID
