#!/bin/bash
#SBATCH --job-name=sim_TabPFN_generate
#SBATCH --output=logs/sim_TabPFN_generate_%A_%a.out
#SBATCH --error=logs/sim_TabPFN_generate_%A_%a.err
#SBATCH --array=0-99%8
#SBATCH --cpus-per-task=8
#SBATCH --time=2-00:00:00
#SBATCH --mem=16G
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --exclude=gpu002,gpu003,gpu004,gpu011,gpu014

# Submit from batch/ after creating logs/. Each task processes ten independent
set -eo pipefail
module purge
source /home/$USER/.bashrc
source activate hivae
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

PROJECT_ROOT="${PROJECT_ROOT:-${SLURM_SUBMIT_DIR}/..}"
N_SAMPLES="${N_SAMPLES:-600}"
N_GENERATED="${N_GENERATED:-50}"
# CONTROL_FRACTION="${CONTROL_FRACTION:-0.3333333333333333}"
ARCHIVE_ROOT="${ARCHIVE_ROOT:-${PROJECT_ROOT}/dataset/Simulations_aug_indep_traincontrol/generated_two_stage_TabPFN_N${N_SAMPLES}_control1of3}"
MC_START=$((SLURM_ARRAY_TASK_ID * 10 + 1))
cd "$PROJECT_ROOT"

echo "host=${HOSTNAME} job=${SLURM_JOB_ID} task=${SLURM_ARRAY_TASK_ID}"
echo "SLURM_JOB_GPUS=${SLURM_JOB_GPUS:-<unset>} CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-<unset>}"
nvidia-smi -L

python3 script/simulation_generate_aug_traincontrol_parallel_TabPFN.py \
  --mc-start "$MC_START" \
  --n-mc 10 \
  --n-samples "$N_SAMPLES" \
  --n-generated-dataset "$N_GENERATED" \
  --generators TabPFN-naive \
  --device cuda \
  --output-dir "$ARCHIVE_ROOT"
    # --control-fractions "$CONTROL_FRACTION" \
