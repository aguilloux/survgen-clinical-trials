#!/bin/bash
#SBATCH --job-name=sim_analyze
#SBATCH --output=logs/sim_analyze_%A_%a.out
#SBATCH --error=logs/sim_analyze_%A_%a.err
#SBATCH --array=0-9
#SBATCH --cpus-per-task=8
#SBATCH --time=2-00:00:00
#SBATCH --mem=16G
#SBATCH --partition=gpu

# Override TABPFN_ARCHIVE_ROOT/TABFORGE_ARCHIVE_ROOT and their RESULT_ROOT
# counterparts when analyzing another generation run.
set -eo pipefail
module purge
source /home/$USER/.bashrc
source activate hivae

PROJECT_ROOT="${PROJECT_ROOT:-${SLURM_SUBMIT_DIR}/..}"
N_SAMPLES="${N_SAMPLES:-600}"
N_MC_PER_TASK="${N_MC_PER_TASK:-10}"
DATASET_ROOT="${PROJECT_ROOT}/dataset/Simulations_aug_indep_traincontrol"
TABPFN_ARCHIVE_ROOT="${TABPFN_ARCHIVE_ROOT:-${DATASET_ROOT}/generated_two_stage_TabPFN_N${N_SAMPLES}_control1of3}"
TABFORGE_ARCHIVE_ROOT="${TABFORGE_ARCHIVE_ROOT:-${DATASET_ROOT}/generated_two_stage_TabFORGE_N${N_SAMPLES}_control1of3}"
TABPFN_RESULT_ROOT="${TABPFN_RESULT_ROOT:-${DATASET_ROOT}/results_two_stage_TabPFN_N${N_SAMPLES}_control1of3}"
TABFORGE_RESULT_ROOT="${TABFORGE_RESULT_ROOT:-${DATASET_ROOT}/results_two_stage_TabFORGE_N${N_SAMPLES}_control1of3}"
MC_START=$((SLURM_ARRAY_TASK_ID * N_MC_PER_TASK + 1))
MC_END=$((MC_START + N_MC_PER_TASK - 1))

cd "$PROJECT_ROOT"
for model in TabPFN TabFORGE; do
  if [[ "$model" == TabPFN ]]; then
    archive_root="$TABPFN_ARCHIVE_ROOT"
    result_root="$TABPFN_RESULT_ROOT"
  else
    archive_root="$TABFORGE_ARCHIVE_ROOT"
    result_root="$TABFORGE_RESULT_ROOT"
  fi
  echo "Analyzing ${model} MC ${MC_START}-${MC_END} from ${archive_root}"
  python3 script/simulation_analyze_aug_traincontrol_parallel.py \
    --mc-start "$MC_START" \
    --n-mc "$N_MC_PER_TASK" \
    --input-dir "$archive_root" \
    --output "${result_root}/results_MC_${MC_START}to${MC_END}.csv" \
    --generators "${model}-naive"
done
